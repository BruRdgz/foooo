<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code><![CDATA[extensions [ csv gis ]

globals [
  day-count
  max-days

  num-farms

  total-infections
  total-deaths
  total-culled
  cumulative-cost
  current-rt
  exposed-history

  log-file-name

  selected-farm

  gis-dataset-limite        ;; poligono do limite de Pernambuco
  gis-dataset-hidrografia   ;; rios / acudes / corpos d'agua
  gis-dataset-granjas       ;; pontos das granjas (import via shapefile)
]

breed [farms farm]
breed [birds bird]
breed [trucks truck]

farms-own [
  farm-id
  pop-total
  susceptible
  exposed
  infected
  recovered
  dead
  biosecurity

  notified?
  first-infection-day
  detection-day
  reaction-day

  quarantined?
  culled?
  under-biosec-boost?

  new-exposed-today
]

birds-own [
  bird-state
  days-infected
]

trucks-own [
  contaminated?
  days-contaminated
  at-farm
]

patches-own [
  water?
]

;; =====================================================================
;; SETUP
;; =====================================================================
to setup
  clear-all

  set day-count 0
  set max-days min list 365 (simulation-duration-months * 30)

  set total-infections 0
  set total-deaths 0
  set total-culled 0
  set cumulative-cost 0
  set current-rt 0
  set exposed-history []
  set selected-farm nobody
  set num-farms 0

  setup-log

  ;; carrega a base cartografica ANTES de tudo, pois define o
  ;; sistema de coordenadas (envelope) que todo o resto vai usar
  setup-gis-environment

  ifelse importar-granjas-shp? [
    import-farms-gis
  ] [
    ifelse importar-arquivo? [
      import-farms
    ] [
      setup-default-farms
    ]
  ]

  setup-water-points
  setup-birds
  setup-trucks
  seed-initial-outbreak

  update-visuals
  reset-ticks
end

;; ---------------------------------------------------------------------
;; NOVA: carrega camadas GIS e define a transformacao de coordenadas
;; ---------------------------------------------------------------------
to setup-gis-environment
  set gis-dataset-limite nobody
  set gis-dataset-hidrografia nobody

  ifelse enable-gis-map? [
    user-message "Selecione o arquivo .shp do LIMITE ESTADUAL de Pernambuco (ex: PE_UF_2025.shp)."
    let path-limite user-file
    ifelse path-limite != false [
      set gis-dataset-limite gis:load-dataset path-limite
      gis:set-world-envelope (gis:envelope-of gis-dataset-limite)
      gis:set-drawing-color gray - 2
      gis:draw gis-dataset-limite 2
    ] [
      user-message "Nenhum arquivo selecionado para o limite. Usando envelope aproximado de PE."
      gis:set-world-envelope (list -41.4 -34.8 -9.5 -7.1)
    ]

    user-message "Selecione o arquivo .shp da HIDROGRAFIA de PE (clique Cancelar se ainda nao tiver)."
    let path-hidro user-file
    if path-hidro != false [
      set gis-dataset-hidrografia gis:load-dataset path-hidro
      gis:set-drawing-color (list 30 90 200)
      gis:draw gis-dataset-hidrografia 1
    ]
  ] [
    ;; mapa GIS desligado: ainda define um envelope aproximado para
    ;; que import-farms (lat/lon) continue funcionando corretamente
    gis:set-world-envelope (list -41.4 -34.8 -9.5 -7.1)
  ]
end

to setup-default-farms
  let i 0
  create-farms num-farms-default [
    place-in-pe-polygon

    set farm-id i + 1
    set pop-total population-per-farm
    set susceptible pop-total
    set exposed 0
    set infected 0
    set recovered 0
    set dead 0

    set biosecurity base-biosecurity + (random 21) - 10
    if biosecurity < 0 [ set biosecurity 0 ]
    if biosecurity > 100 [ set biosecurity 100 ]

    set notified? false
    set first-infection-day -1
    set detection-day -1
    set reaction-day -1
    set quarantined? false
    set culled? false
    set under-biosec-boost? false
    set new-exposed-today 0

    set shape "house"
    set size 2.5
    set color green

    set i i + 1
  ]
  set num-farms num-farms-default
end

;; ---------------------------------------------------------------------
;; CSV agora traz LAT/LON reais em vez de x/y arbitrarios
;; Formato esperado do CSV: id, lat, lon, pop_total, biosseguranca
;; ---------------------------------------------------------------------
to import-farms
  let path user-file
  ifelse path = false [
    user-message "Nenhum arquivo selecionado. Usando granjas padrao."
    setup-default-farms
  ] [
    let rows csv:from-file path
    set rows but-first rows
    let n 0
    foreach rows [ row ->
      let lat item 1 row
      let lon item 2 row
      let loc gis:project-lat-lon lat lon

      ifelse not empty? loc [
        create-farms 1 [
          set farm-id item 0 row
          setxy (item 0 loc) (item 1 loc)
          set pop-total item 3 row
          set susceptible pop-total
          set exposed 0
          set infected 0
          set recovered 0
          set dead 0
          set biosecurity item 4 row

          set notified? false
          set first-infection-day -1
          set detection-day -1
          set reaction-day -1
          set quarantined? false
          set culled? false
          set under-biosec-boost? false
          set new-exposed-today 0

          set shape "house"
          set size 2.5
          set color green
        ]
        set n n + 1
      ] [
        log-event "AVISO_IMPORTACAO" (word "Granja " (item 0 row) " fora dos limites de PE - ignorada")
      ]
    ]
    set num-farms n
    user-message (word "Importadas " n " granjas georreferenciadas do arquivo.")
  ]
end

;; ---------------------------------------------------------------------
;; importa granjas direto de um shapefile de pontos
;; Shapefile esperado com atributos: ID, POP_TOTAL, BIOSEG
;; ---------------------------------------------------------------------
to import-farms-gis
  let path user-file
  ifelse path = false [
    user-message "Nenhum arquivo selecionado. Usando granjas padrao."
    setup-default-farms
  ] [
    set gis-dataset-granjas gis:load-dataset path

    gis:create-turtles-from-points-manual gis-dataset-granjas farms
      [["ID" "farm-id"] ["POP_TOTAL" "pop-total"] ["BIOSEG" "biosecurity"]]
    [
      set susceptible pop-total
      set exposed 0
      set infected 0
      set recovered 0
      set dead 0

      set notified? false
      set first-infection-day -1
      set detection-day -1
      set reaction-day -1
      set quarantined? false
      set culled? false
      set under-biosec-boost? false
      set new-exposed-today 0

      set shape "house"
      set size 2.5
      set color green
    ]

    set num-farms count farms
    user-message (word "Importadas " num-farms " granjas do shapefile.")
  ]
end

;; ---------------------------------------------------------------------
;; usa hidrografia real em vez de pontos aleatorios
;; ---------------------------------------------------------------------
to setup-water-points
  ask patches [ set water? false ]

  ifelse enable-bird-layer? and gis-dataset-hidrografia != nobody and gis-dataset-limite != nobody [
    ;; primeiro restringe aos patches que estao DENTRO do poligono real de PE
    ;; (o envelope e um retangulo que tambem pega pedacos de estados vizinhos,
    ;; entao sem esse filtro os rios da PB/AL/BA tambem contariam)
    let patches-pe patches gis:intersecting gis-dataset-limite
    let patches-agua patches-pe gis:intersecting gis-dataset-hidrografia
    ask patches-agua [
      set water? true
    ]
  ] [
    if number-of-water-points > 0 [
      ask n-of number-of-water-points patches with [not any? farms-here] [
        set water? true
        set pcolor blue - 1
      ]
    ]
  ]
end

;; ---------------------------------------------------------------------
;; aves nascem dentro do poligono de Pernambuco
;; ---------------------------------------------------------------------
to setup-birds
  if enable-bird-layer? [
    create-birds number-of-birds [
      place-in-pe-polygon
      set shape "bird"
      set size 1.2
      set bird-state "S"
      set color white
      set days-infected 0
      if random-float 100 < initial-bird-infection-pct [
        set bird-state "I"
        set color orange
      ]
    ]
  ]
end

;; turtle procedure generica: posiciona QUALQUER turtle (ave ou granja)
;; dentro do poligono real de PE, se o shapefile do limite estiver
;; carregado; senao usa posicao aleatoria no mundo (comportamento antigo)
to place-in-pe-polygon
  ifelse gis-dataset-limite != nobody [
    let limite-feature first gis:feature-list-of gis-dataset-limite
    let pt gis:random-point-inside limite-feature
    let loc gis:location-of pt
    ifelse not empty? loc [
      setxy (item 0 loc) (item 1 loc)
    ] [
      setxy random-xcor random-ycor
    ]
  ] [
    setxy random-xcor random-ycor
  ]
end

to setup-trucks
  if enable-fomite-layer? and any? farms [
    create-trucks number-of-trucks [
      set shape "truck"
      set size 1.5
      set color gray
      set contaminated? false
      set days-contaminated 0
      set at-farm one-of farms
      move-to at-farm
    ]
  ]
end

to seed-initial-outbreak
  if any? farms [
    ask one-of farms [
      let seed min list susceptible initial-infected
      set susceptible susceptible - seed
      set exposed exposed + seed
      set first-infection-day 0
      set detection-day (random (detection-time-max + 1))
      log-event "INTRODUCAO_INICIAL" (word "Granja " farm-id ": foco inicial com " seed " aves expostas")
    ]
  ]
end

to setup-log
  set log-file-name "h5n1_simulacao_log.csv"
  if file-exists? log-file-name [ file-delete log-file-name ]
  file-open log-file-name
  file-print csv:to-row (list "dia" "tipo_evento" "detalhes")
  file-close
end

to log-event [tipo detalhes]
  file-open log-file-name
  file-print csv:to-row (list day-count tipo detalhes)
  file-close
end

;; =====================================================================
;; GO
;; =====================================================================
to go
  if day-count >= max-days [
    user-message "Simulação concluída: duração máxima atingida."
    stop
  ]

  set day-count day-count + 1
  ask farms [ set new-exposed-today 0 ]

  intra-farm-transmission

  if enable-bird-layer? [
    move-birds
    bird-to-farm-transmission
  ]

  if enable-fomite-layer? [
    move-trucks
  ]

  update-detection
  update-reaction
  update-economic-cost
  update-rt
  update-visuals

  tick
end

to intra-farm-transmission
  ask farms with [not culled?] [
    let n pop-total
    if n > 0 [

      let effective-beta beta * (1 - (biosecurity / 100))
      let sigma (1 / incubation-days)
      let gamma (1 / infectious-period-days)

      let force-of-infection (effective-beta * infected / n)
      let new-exp (susceptible * force-of-infection)
      if new-exp > susceptible [ set new-exp susceptible ]

      let new-inf (exposed * sigma)
      if new-inf > exposed [ set new-inf exposed ]

      let leaving-infected (infected * gamma)
      if leaving-infected > infected [ set leaving-infected infected ]
      let new-dead (leaving-infected * (mortality-rate / 100))
      let new-recovered (leaving-infected - new-dead)

      set susceptible susceptible - new-exp
      set exposed exposed + new-exp - new-inf
      set infected infected + new-inf - leaving-infected
      set recovered recovered + new-recovered
      set dead dead + new-dead

      set new-exposed-today new-exposed-today + new-exp
      set total-infections total-infections + new-exp
      set total-deaths total-deaths + new-dead

      if new-exp > 0.5 [
        log-event "INFECCAO" (word "Granja " farm-id ": +" (precision new-exp 1) " aves expostas (intra-granja)")
      ]

      if new-exp > 0 and first-infection-day = -1 [
        set first-infection-day day-count
        set detection-day day-count + (random (detection-time-max + 1))
        log-event "PRIMEIRA_EXPOSICAO" (word "Granja " farm-id " teve primeira exposição")
      ]
    ]
  ]
end

to move-birds
  ask birds [
    if bird-state = "I" [
      set days-infected days-infected + 1
      if days-infected > bird-infection-duration [ die ]
    ]
  ]
  ask birds [
    ifelse any? patches with [water?] and random-float 100 < 60 [
      face min-one-of patches with [water?] [distance myself]
      fd 1
    ] [
      rt random 360
      fd 1
    ]
  ]
end

to bird-to-farm-transmission
  ask farms with [not culled? and not quarantined?] [
    let nearby-infected-birds birds with [bird-state = "I" and distance myself <= 3]
    let near-water any? patches in-radius 3 with [water?]
    if any? nearby-infected-birds and susceptible > 0 [
      let prob infection-prob-bird-to-farm
      if near-water [ set prob prob * 1.5 ]
      if prob > 100 [ set prob 100 ]
      if random-float 100 < prob [
        let seed min list susceptible seed-size-birds
        set susceptible susceptible - seed
        set exposed exposed + seed
        set new-exposed-today new-exposed-today + seed
        set total-infections total-infections + seed
        log-event "INTRODUCAO_AVES_MIGRATORIAS" (word "Granja " farm-id ": exposição via aves/água (+" seed ")")
        if first-infection-day = -1 [
          set first-infection-day day-count
          set detection-day day-count + (random (detection-time-max + 1))
        ]
      ]
    ]
  ]
end

to move-trucks
  ask trucks [
    if contaminated? [
      set days-contaminated days-contaminated + 1
      if days-contaminated > fomite-survival-days [
        set contaminated? false
        set days-contaminated 0
      ]
    ]

    if at-farm != nobody [
      truck-visit-farm
    ]

    let candidatos farms with [not culled?]
    if any? candidatos [
      let next-farm one-of candidatos
      set at-farm next-farm
      move-to next-farm
      set color ifelse-value contaminated? [red] [gray]
    ]
  ]
end

to truck-visit-farm
  let f at-farm
  let truck-is-contaminated? contaminated?
  let farm-is-quarantined? [quarantined?] of f
  let farm-is-infected? ([infected] of f > 0)

  if not farm-is-quarantined? and truck-is-contaminated? [
    ask f [
      if susceptible > 0 and random-float 100 < infection-prob-truck-to-farm [
        let seed min list susceptible seed-size-fomite
        set susceptible susceptible - seed
        set exposed exposed + seed
        set new-exposed-today new-exposed-today + seed
        set total-infections total-infections + seed
        log-event "INTRODUCAO_FOMITE" (word "Granja " farm-id ": exposição via caminhão/fômite (+" seed ")")
        if first-infection-day = -1 [
          set first-infection-day day-count
          set detection-day day-count + (random (detection-time-max + 1))
        ]
      ]
    ]
  ]

  if not farm-is-quarantined? and farm-is-infected? [
    set contaminated? true
    set days-contaminated 0
  ]
end

to update-detection
  ask farms with [not notified? and first-infection-day > -1 and (infected > 0 or exposed > 0)] [
    if day-count >= detection-day [
      set notified? true
      set reaction-day day-count + (random (reaction-time-max + 1))
      log-event "DETECCAO" (word "Granja " farm-id " notificada às autoridades")
    ]
  ]
end

to update-reaction
  ask farms with [notified? and not quarantined? and not culled?] [
    if day-count >= reaction-day [
      set quarantined? true
      log-event "REACAO_AUTOMATICA" (word "Granja " farm-id ": bloqueio de movimentação automático aplicado")
    ]
  ]
end

to select-farm-with-mouse
  if mouse-inside? [
    let mx mouse-xcor
    let my mouse-ycor
    if any? farms [
      let nearest min-one-of farms [ distancexy mx my ]
      if nearest != nobody [
        set selected-farm nearest
      ]
    ]
  ]
end

to-report selected-farm-label
  ifelse selected-farm = nobody [
    report "Nenhuma granja selecionada"
  ] [
    report (word "Granja " [farm-id] of selected-farm)
  ]
end

to apply-intervention-selected
  if selected-farm != nobody [
    ask selected-farm [
      if not culled? [
        if intervention-type = "Sacrificio Sanitario" [ apply-stamping-out ]
        if intervention-type = "Bloqueio de Movimentacao" [ apply-movement-block ]
        if intervention-type = "Melhoria de Biosseguranca" [ apply-biosecurity-boost ]
      ]
    ]
  ]
end

to apply-stamping-out
  let cull-count (susceptible + exposed + infected)
  set cumulative-cost cumulative-cost + (cull-count * cull-cost-per-bird)
  set total-culled total-culled + cull-count
  set susceptible 0
  set exposed 0
  set infected 0
  set culled? true
  set quarantined? true
  set color black
  log-event "SACRIFICIO_SANITARIO" (word "Granja " farm-id ": " (precision cull-count 0) " aves sacrificadas")

  ask farms in-radius stamping-out-radius with [self != myself and not culled?] [
    set quarantined? true
    log-event "QUARENTENA_PERIFERICA" (word "Granja " farm-id ": quarentena por raio de sacrifício")
  ]
end

to apply-movement-block
  set quarantined? true
  log-event "BLOQUEIO_MOVIMENTACAO" (word "Granja " farm-id ": movimentação de caminhões suspensa manualmente")
end

to apply-biosecurity-boost
  set biosecurity min list 100 (biosecurity + biosecurity-boost-amount)
  set cumulative-cost cumulative-cost + biosecurity-investment-cost
  set under-biosec-boost? true
  log-event "MELHORIA_BIOSSEGURANCA" (word "Granja " farm-id ": biosseguridade elevada para " biosecurity "%")
end

to update-economic-cost
  ask farms with [quarantined? and not culled?] [
    set cumulative-cost cumulative-cost + quarantine-cost-per-day
  ]
end

to update-rt
  let infections-now sum [new-exposed-today] of farms
  set exposed-history lput infections-now exposed-history

  let hist-len length exposed-history
  ifelse hist-len > generation-interval-days [
    let infections-past item (hist-len - 1 - generation-interval-days) exposed-history
    ifelse infections-past > 0 [
      set current-rt infections-now / infections-past
    ] [
      set current-rt 0
    ]
  ] [
    set current-rt 0
  ]
end

to update-visuals
  ask farms [
    ifelse culled? [
      set color black
    ] [
      ifelse infected > 0 or exposed > 0 [
        ifelse notified? [ set color red ] [ set color orange ]
      ] [
        ifelse quarantined? [ set color yellow ] [ set color green ]
      ]
    ]
  ]
end

to-report healthy-farms-count
  report count farms with [not culled? and infected = 0 and exposed = 0]
end

to-report notified-infected-farms-count
  report count farms with [notified? and (infected > 0 or exposed > 0)]
end

to-report hidden-infected-farms-count
  report count farms with [not notified? and (infected > 0 or exposed > 0)]
end

to-report total-dead-birds
  report sum [dead] of farms
end

to-report total-culled-birds
  report total-culled
end

to-report cumulative-cost-brl
  report cumulative-cost
end

to-report days-remaining
  report max-days - day-count
end
]]></code>
  <widgets>
    <view x="368" wrappingAllowedX="false" y="10" frameRate="30.0" minPycor="-50" height="304" showTickCounter="true" patchSize="3.0" fontSize="10" wrappingAllowedY="false" width="840" tickCounterLabel="ticks" maxPycor="50" updateMode="0" maxPxcor="140" minPxcor="-140"></view>
    <slider x="5" step="5" y="60" max="100" width="160" display="base-biosecurity" height="50" min="0" direction="Horizontal" default="50.0" variable="base-biosecurity"></slider>
    <slider x="5" step="10" y="5" max="200" width="160" display="num-farms-default" height="50" min="10" direction="Horizontal" default="50.0" variable="num-farms-default"></slider>
    <slider x="170" step="500" y="5" max="20000" width="185" display="population-per-farm" height="50" min="500" direction="Horizontal" default="5000.0" variable="population-per-farm"></slider>
    <slider x="170" step="10" y="60" max="500" width="185" display="initial-infected" height="50" min="1" direction="Horizontal" default="50.0" variable="initial-infected"></slider>
    <slider x="170" step="1" y="115" max="14" width="185" display="incubation-days" height="50" min="1" direction="Horizontal" default="4.0" variable="incubation-days"></slider>
    <slider x="5" step="0.1" y="115" max="5.0" width="160" display="beta" height="50" min="0.5" direction="Horizontal" default="3.2" variable="beta"></slider>
    <slider x="5" step="1" y="225" max="30" width="160" display="detection-time-max" height="50" min="1" direction="Horizontal" default="7.0" variable="detection-time-max"></slider>
    <slider x="170" step="5" y="170" max="100" width="185" display="mortality-rate" height="50" min="50" direction="Horizontal" default="90.0" variable="mortality-rate"></slider>
    <slider x="5" step="1" y="170" max="10" width="160" display="infectious-period-days" height="50" min="1" direction="Horizontal" default="3.0" variable="infectious-period-days"></slider>
    <slider x="170" step="1" y="225" max="14" width="185" display="reaction-time-max" height="50" min="0" direction="Horizontal" default="3.0" variable="reaction-time-max"></slider>
    <slider x="170" step="5" y="280" max="100" width="185" display="number-of-birds" height="50" min="0" direction="Horizontal" default="20.0" variable="number-of-birds"></slider>
    <slider x="5" step="1" y="280" max="12" width="160" display="simulation-duration-months" height="50" min="1" direction="Horizontal" default="6.0" variable="simulation-duration-months"></slider>
    <slider x="5" step="5" y="335" max="50" width="160" display="initial-bird-infection-pct" height="50" min="0" direction="Horizontal" default="10.0" variable="initial-bird-infection-pct"></slider>
    <slider x="170" step="1" y="335" max="14" width="185" display="bird-infection-duration" height="50" min="1" direction="Horizontal" default="5.0" variable="bird-infection-duration"></slider>
    <slider x="5" step="5" y="390" max="100" width="160" display="infection-prob-bird-to-farm" height="50" min="0" direction="Horizontal" default="15.0" variable="infection-prob-bird-to-farm"></slider>
    <slider x="170" step="5" y="390" max="100" width="185" display="seed-size-birds" height="50" min="1" direction="Horizontal" default="10.0" variable="seed-size-birds"></slider>
    <slider x="170" step="1" y="445" max="30" width="185" display="number-of-trucks" height="50" min="0" direction="Horizontal" default="5.0" variable="number-of-trucks"></slider>
    <slider x="5" step="1" y="445" max="30" width="160" display="number-of-water-points" height="50" min="0" direction="Horizontal" default="8.0" variable="number-of-water-points"></slider>
    <slider x="365" step="5" y="335" max="100" width="160" display="infection-prob-truck-to-farm" height="50" min="0" direction="Horizontal" default="20.0" variable="infection-prob-truck-to-farm"></slider>
    <slider x="530" step="5" y="335" max="100" width="165" display="seed-size-fomite" height="50" min="1" direction="Horizontal" default="15.0" variable="seed-size-fomite"></slider>
    <slider x="530" step="1" y="390" max="15" width="165" display="stamping-out-radius" height="50" min="1" direction="Horizontal" default="5.0" variable="stamping-out-radius"></slider>
    <slider x="365" step="1" y="390" max="14" width="160" display="fomite-survival-days" height="50" min="1" direction="Horizontal" default="5.0" variable="fomite-survival-days"></slider>
    <slider x="365" step="1" y="445" max="100" width="160" display="cull-cost-per-bird" height="50" min="0" direction="Horizontal" default="8.0" variable="cull-cost-per-bird"></slider>
    <slider x="530" step="100" y="445" max="5000" width="165" display="quarantine-cost-per-day" height="50" min="0" direction="Horizontal" default="500.0" variable="quarantine-cost-per-day"></slider>
    <slider x="1220" step="5" y="5" max="50" width="150" display="biosecurity-boost-amount" height="50" min="5" direction="Horizontal" default="20.0" variable="biosecurity-boost-amount"></slider>
    <slider x="1375" step="500" y="5" max="20000" width="150" display="biosecurity-investment-cost" height="50" min="0" direction="Horizontal" default="5000.0" variable="biosecurity-investment-cost"></slider>
    <switch x="1220" y="60" height="40" on="true" variable="enable-bird-layer?" width="95" display="enable-bird-layer?"></switch>
    <switch x="1320" y="60" height="40" on="true" variable="enable-fomite-layer?" width="100" display="enable-fomite-layer?"></switch>
    <switch x="1425" y="60" height="40" on="false" variable="importar-arquivo?" width="130" display="importar-arquivo?"></switch>
    <switch x="1560" y="60" height="40" on="true" variable="enable-gis-map?" width="120" display="enable-gis-map?"></switch>
    <chooser x="1220" y="110" height="60" variable="intervention-type" current="0" width="250" display="intervention-type">
      <choice type="string" value="Sacrificio Sanitario"></choice>
      <choice type="string" value="Bloqueio de Movimentacao"></choice>
      <choice type="string" value="Melhoria de Biosseguranca"></choice>
    </chooser>
    <switch x="1480" y="120" height="40" on="true" variable="importar-granjas-shp?" width="150" display="importar-granjas-shp?"></switch>
    <slider x="1530" step="1" y="5" max="10" width="150" display="generation-interval-days" height="50" min="1" direction="Horizontal" default="5.0" variable="generation-interval-days"></slider>
    <button x="1220" y="180" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="75" display="Configurar">setup</button>
    <plot x="1455" autoPlotX="true" yMax="10.0" autoPlotY="true" yAxis="Custo Acumulado (R$)" y="360" xMin="0.0" height="175" legend="true" xMax="10.0" yMin="0.0" width="230" xAxis="Dias" display="Impacto Economico">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="custo" color="-13345367" legend="true">
        <setup></setup>
        <update>plot cumulative-cost</update>
      </pen>
    </plot>
    <plot x="1220" autoPlotX="true" yMax="10.0" autoPlotY="true" yAxis="Numero de Granjas" y="360" xMin="0.0" height="175" legend="true" xMax="10.0" yMin="0.0" width="230" xAxis="Dias" display="Curva Epidemiologica">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="saudaveis" color="-13840069" legend="true">
        <setup></setup>
        <update>plot healthy-farms-count</update>
      </pen>
      <pen interval="1.0" mode="0" display="notificadas" color="-2674135" legend="true">
        <setup></setup>
        <update>plot notified-infected-farms-count</update>
      </pen>
      <pen interval="1.0" mode="0" display="ocultas" color="-955883" legend="true">
        <setup></setup>
        <update>plot hidden-infected-farms-count</update>
      </pen>
    </plot>
    <monitor x="1535" precision="17" y="295" height="60" fontSize="11" width="100" display="Granjas Notificadas">notified-infected-farms-count</monitor>
    <monitor x="1430" precision="17" y="295" height="60" fontSize="11" width="100" display="Granjas Saudáveis">healthy-farms-count</monitor>
    <monitor x="1325" precision="17" y="295" height="60" fontSize="11" width="100" display="Custo Acumulado (R$)">cumulative-cost-brl</monitor>
    <monitor x="1220" precision="17" y="295" height="60" fontSize="11" width="100" display="Total de Aves Sacrificadas">total-culled-birds</monitor>
    <monitor x="1640" precision="17" y="230" height="60" fontSize="11" width="100" display="Total de Aves Mortas">total-dead-birds</monitor>
    <monitor x="1535" precision="17" y="230" height="60" fontSize="11" width="100" display="Rt (Taxa de Propagação)">current-rt</monitor>
    <monitor x="1430" precision="17" y="230" height="60" fontSize="11" width="100" display="Granja Selecionada">selected-farm-label</monitor>
    <monitor x="1325" precision="17" y="230" height="60" fontSize="11" width="100" display="Dias Restantes">days-remaining</monitor>
    <monitor x="1220" precision="17" y="230" height="60" fontSize="11" width="100" display="Dia">day-count</monitor>
    <button x="1600" y="180" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="125" display="Aplicar Intervenção Selecionada">apply-intervention-selected</button>
    <button x="1470" y="180" height="40" disableUntilTicks="false" forever="true" kind="Observer" width="120" display="Selecionar Granja">select-farm-with-mouse</button>
    <button x="1380" y="180" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="80" display="Passo Único">go</button>
    <button x="1300" y="180" height="40" disableUntilTicks="false" forever="true" kind="Observer" width="71" display="Rodar">go</button>
    <monitor x="1640" precision="17" y="295" height="60" fontSize="11" width="100" display="Granjas Ocultas">hidden-infected-farms-count</monitor>
    <plot x="985" autoPlotX="true" yMax="5.0" autoPlotY="false" yAxis="Rt" y="360" xMin="0.0" height="175" legend="true" xMax="10.0" yMin="0.0" width="230" xAxis="Dias" display="Taxa de Propagacao Rt">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="rt" color="-5825686" legend="true">
        <setup></setup>
        <update>plot current-rt</update>
      </pen>
      <pen interval="1.0" mode="0" display="limiar" color="-5987164" legend="true">
        <setup></setup>
        <update>plot 1</update>
      </pen>
    </plot>
  </widgets>
